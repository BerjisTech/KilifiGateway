<% 
  store = product.store
  branch = product.branch
  store_name = store.name
  branch_name = branch.location
  owner = store.owner
%>
<div id="<%= dom_id product %>" class="m-1 bg-white rounded-md p-2">
  <div class="position-relative w-full h-[250px] bg-blue-200 rounded-md">
    <div class="position-absolute d-flex align-items-center justify-content-between top-0 left-0 right-0 w-full p-2">
      <span class="material-icons">store</span>
      <span class="material-icons">wishlist</span>
    </div>
    <div class="position-absolute d-flex align-items-center justify-content-between bottom-0 left-0 right-0 w-full p-2">
      <span class="material-icons">store</span>
      <span class="material-icons">store</span>
    </div>
  </div>
  <% if action_name != "show" %>
    <div class="d-flex align-items-center justify-content-center gap-2 mt-2">
      <div class="d-flex flex-column align-items-start justify-content-start">
        <span class="<%= 'line-through text-red-600 text-sm' if product.discount.present? %>">$ <%= product.price %></span>
        <span class="text-blue-600 fw-bold">$ <%= product.discount %></span>
      </div>
      <% if product.product_variants.blank? %>
        <span class="position-relative flex-fill rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium d-flex align-items-center justify-content-center text-decoration-none">
          <span>Buy Now</span>
          <% if product.on_sale %>
            <span class="absolute top-0 right-0 mt-2 mr-2 bg-red-500 text-white px-2 py-1 rounded-full text-xs">On Sale</span>
          <% end %>
        </span>
      <% else %>
        <%= link_to product, class: "position-relative flex-fill rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium d-flex align-items-center justify-content-center text-decoration-none" do %>
          <span>Customize</span>
          <% if product.on_sale %>
            <span class="absolute top-0 right-0 mt-2 mr-2 bg-red-500 text-white px-2 py-1 rounded-full text-xs">On Sale</span>
          <% end %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
