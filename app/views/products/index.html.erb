<div class="w-full p-3">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-blue-50 mb-5 text-blue-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>
  <div id="products" class="min-w-full d-flex flex-wrap">
    <% @products.each_with_index do |product, index| %>
      <div class="flex-fill min-w-[300px]"><%= render partial: 'products/product_condensed', locals: { product: product, index: index } %></div>
    <% end %>
  </div>
</div>
