<div class="block w-full h-screen bg-no-repeat bg-cover bg-opacity-20 bg-center bg-fixed bg-hero-pattern d-flex align-items-start justify-content-center gap-3 flex-column">
  <div class="text-[70px] fw-bolder text-slate-800 backdrop-blur-xl px-4">All Your Needs In One Place</div>
  <%= form_with(model: Search.new, class: "min-w-[50%] contents d-flex align-items-center justify-content-start bg-green-400 backdrop-blur-xl") do |form| %>
    <%= form.hidden_field :location, value: request.original_url %>
    <%= form.hidden_field :referer, value: request.referer %>
    <div class="form-floating my-3 flex-fill">
      <%= form.text_field :term, class: "rounded-none bg-transparent border-0 form-control", placeholder: 'Search within Kilifi' %>
      <%= form.label :term, 'Search Anything here', class: 'bg-transparent' %>
    </div>
    <div class="form-floating my-3">
      <%= form.select :category, @search_categories, {}, class: "rounded-none bg-transparent border-0 form-select", 'aria-label': 'Service Category' %>
      <%= form.label :category, 'Service Category', class: 'bg-transparent' %>
    </div>
    <div class="inline bg-green-800 h-full d-flex align-items-center justify-content-center">
      <%= form.button class: "rounded-lg py-3 px-5 bg-transparent text-white text-decoration-none inline-block font-medium text-decoration-none cursor-pointer" do %>
        <i class="material-icons fs-1">search</i>
      <% end %>
    </div>
  <% end %>
</div>
<div class="sticky grid grid-cols-4 bg-slate-100">
  <%= link_to "Accomodation", "#accomodation", class: "py-4 text-center text-decoration-none"%>
  <%= link_to "Shopping", "#product", class: "py-4 text-center text-decoration-none #{ controller_name }"%>
  <%= link_to "On Demand Services", "#ondemandservice", class: "py-4 text-center text-decoration-none"%>
  <%= link_to "Government Services", "#governmentfacility", class: "py-4 text-center text-decoration-none"%>
</div>
<div class="row m-0 p-0 h-full" role="button" id="accomodation">
  <% Accomodation.limit(4).each_with_index do |accomodation, index| %>
    <div class="col-sm-3 px-0 py-2 m-0"><%= render partial: 'accomodations/accomodation_condensed', locals: { accomodation: accomodation, index: index } %></div>
  <% end %>
</div>
<div class="row m-0 p-0 h-full" role="button" id="product">
  <% (Product.limit(2) + Service.limit(2)).shuffle.each_with_index do |item, index| %>
    <% if item.is_a?(Product) %>
      <div class="col-sm-3 p-0 m-0"><%= render partial: 'products/product_condensed', locals: { product: item, index: index } %></div>
    <% elsif item.is_a?(Service) %>
      <div class="col-sm-3 p-0 m-0"><%= render partial: 'services/service_condensed', locals: { service: item, index: index } %></div>
    <% end %>
  <% end %>
</div>
<div class="row m-0 p-0 h-full" role="button" id="ondemandservice">
  <% OnDemandService.limit(4).each_with_index do |on_demand_service, index| %>
    <div class="col-sm-3 p-0 m-0"><%= render partial: 'on_demand_services/on_demand_service_condensed', locals: { on_demand_service: on_demand_service, index: index } %></div>
  <% end %>
</div>
<div class="row m-0 p-0 h-full" role="button" id="governmentfacility">
  <% GovernmentFacility.limit(4).each_with_index do |government_facility, index| %>
    <div class="col-sm-3 p-0 m-0"><%= render partial: 'government_facilities/government_facility_condensed', locals: { government_facility: government_facility, index: index } %></div>
  <% end %>
</div>
