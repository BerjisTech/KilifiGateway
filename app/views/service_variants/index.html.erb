<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium text-decoration-none rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Service variants</h1>
    <%= link_to 'New service variant', new_service_variant_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white text-decoration-none block font-medium text-decoration-none" %>
  </div>

  <div id="service_variants" class="min-w-full">
    <%= render @service_variants %>
  </div>
</div>
