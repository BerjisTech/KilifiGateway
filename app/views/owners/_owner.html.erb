<div id="<%= dom_id owner %>">
  <p class="my-5">
    <strong class="block font-medium mb-1">User:</strong>
    <%= User.find(owner.user_id).name %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this owner", owner, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium" %>
    <%= link_to 'Edit this owner', edit_owner_path(owner), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium" %>
    <hr class="mt-6">
  <% end %>
</div>
