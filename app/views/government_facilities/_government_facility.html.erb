<div id="<%= dom_id government_facility %>">
  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">Name:</strong>
    <%= government_facility.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">Type:</strong>
    <%= government_facility.type %>
  </p>

  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">Location:</strong>
    <%= government_facility.location %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this government facility", government_facility, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium text-decoration-none" %>
    <%= link_to 'Edit this government facility', edit_government_facility_path(government_facility), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium text-decoration-none" %>
    <hr class="mt-6">
  <% end %>
</div>
