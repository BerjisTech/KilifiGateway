<%
  owner = accomodation.owner
  user = owner.user
%>
<div id="<%= dom_id accomodation %>" class="w-full">
  <div class="row w-full">
    <div class="col-sm-8 h-full">
      <div class="d-flex gap-2 flex-wrap p-0 mt-2">
        <div class="flex-fill d-flex align-items-center justify-content-center">
          <img src="https://picsum.photos/500/300?random=1" class="<%= dom_id accomodation %> rounded-lg h-full object-cover" onload="processImage('<%= dom_id accomodation %>', this.src)">
        </div>
        <div>
          <img src="https://picsum.photos/500/300?random=2" class="rounded-lg h-[100px]">
          <img src="https://picsum.photos/500/300?random=3" class="rounded-lg h-[100px] my-2">
          <img src="https://picsum.photos/500/300?random=4" class="rounded-lg h-[100px] my-2">
          <img src="https://picsum.photos/500/300?random=5" class="rounded-lg h-[100px]">
        </div>
      </div>
    </div>
    <div class="col-sm-4 h-full">
      <div class="d-flex w-full flex-column gap-2">
        <% if action_name != "show" %>
          <div class="d-flex w-full">
            <%= link_to 'visibility', accomodation, class: "text-blue-600 material-icons flex-fill text-decoration-none text-center rounded-lg py-3 px-5 bg-gray-100" %>
            <%= link_to 'edit', edit_accomodation_path(accomodation), class: "text-blue-600 material-icons text-center text-decoration-none rounded-lg py-3 ml-2 px-5 bg-gray-100" %>
          </div>
        <% end %>
        <div class="fw-bold fs-3"><%= accomodation.name.capitalize %></div>
        <div class="d-flex align-items-center justify-content-start gap-2 border-solid border-1 bg-slate-100 p-2 rounded-md">
          <div class="fw-bold fw-bold text-blue-600"><%= ((accomodation.rating/accomodation.rating_count)*100).clamp(0,5) %></div>
          <div class="d-flex flex-column flex-fill text-[12px]">
            <div>Pleasant</div>
            <div><%= accomodation.rating_count %> REVIEWS</div>
          </div>
          <div class="bg-slate-300 rounded-md p-2 fw-bold text-slate-600">More</div>
        </div>
        <div class="d-flex align-items-center justify-content-between p-2">
          <div class="d-flex align-items-center justify-content-center">
            <span class="material-icons">group</span>
            <span class=""><%= accomodation.max_guests %> Persons</span>
          </div>
          <div class="d-flex align-items-center justify-content-center gap-2">
            <span class=""><%= accomodation.max_stay %> nights</span>
            <span class="">incl. taxes</span>
          </div>
        </div>
        <div class="d-flex align-items-center justify-content-start gap-2 border-solid border-1 bg-slate-100 p-2 rounded-md flex-wrap">
          <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
            <strong class="font-medium text-decoration-none material-icons">bathroom</strong>:
            <%= accomodation.bathrooms %>
          </p>
          <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
            <strong class="font-medium text-decoration-none material-icons">bed</strong>:
            <%= accomodation.bedrooms %>
          </p>
          <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
            <strong class="font-medium text-decoration-none material-icons">balcony</strong>:
            <strong class="font-medium text-decoration-none material-icons text-<%= accomodation.balcony ? 'green' : 'red' %>-500"><%= accomodation.balcony ? 'check' : 'cancel' %></strong>
          </p>
          <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
            <strong class="font-medium text-decoration-none material-icons">local_parking</strong>:
            <strong class="font-medium text-decoration-none material-icons text-<%= accomodation.parking ? 'green' : 'red' %>-500"><%= accomodation.parking ? 'check' : 'cancel' %></strong>
          </p>
          <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
            <strong class="font-medium text-decoration-none material-icons">airport_shuttle</strong>:
            <strong class="font-medium text-decoration-none material-icons text-<%= accomodation.transport ? 'green' : 'red' %>-500"><%= accomodation.transport ? 'check' : 'cancel' %></strong>
          </p>
          <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
            <strong class="font-medium text-decoration-none material-icons">room</strong>:
            <%= accomodation.location[0..40] %>...
          </p>
        </div>
        <div class="d-flex align-items-center justify-content-start gap-2 border-solid border-1 bg-slate-100 p-2 rounded-md"></div>
        <div class="d-flex align-items-center justify-content-start gap-2 border-solid border-1 bg-slate-100 p-2 rounded-md"></div>
        <div class="d-flex align-items-center justify-content-start gap-2 border-solid border-1 bg-slate-100 p-2 rounded-md fw-bold text-[12px] text-blue-600">
          <div class="d-flex align-items-center justify-content-start flex-fill flex-column">
            <span class="material-icons">reviews</span>
            <span>REVIEWS</span>
          </div>
          <div class="d-flex align-items-center justify-content-start flex-fill flex-column">
            <span class="material-icons">pin_drop</span>
            <span>LOCATION</span>
          </div>
          <div class="d-flex align-items-center justify-content-start flex-fill flex-column">
            <span class="material-icons">barcode_reader</span>
            <span>AMENITIES</span>
          </div>
          <div class="d-flex align-items-center justify-content-start flex-fill flex-column">
            <span class="material-icons">loyalty</span>
            <span>ALL DEALS</span>
          </div>
        </div>
        <a class="d-flex align-items-center justify-content-start gap-2 border-solid border-1 bg-slate-100 p-2 rounded-md text-decoration-none" href="<%= root_url %>u/<%= user.id %>">
          <img src='https://picsum.photos/500/300?random=<%= rand(1..10) %>' class="w-[50px] h-[50px] rounded-md bg-blue-400" />
          <div class="d-flex flex-column align-items-start justify-content-center h-full flex-fill">
            <span class="text-decoration-none text-slate-800"><%= user.name %></span>
            <span class="text-decoration-none text-slate-400">View Agent Profile</span>
          </div>
          <span class="material-icons">chevron_right</span>
        </a>
      </div>
    </div>
  </div>
  <div class="row w-full">
    <div class="col-sm-8 h-full"></div>
    <div class="col-sm-4 h-full sticky"></div>
  </div>
  <div class="d-flex align-items-center justify-content-start gap-2 border-solid border-1 bg-slate-100 p-2 my-5 rounded-md">
    <% owner.accomodations.limit(5).each_with_index do |accomodation, index| %>
      <div class="col-sm-3 px-0 py-2 m-0"><%= render partial: 'accomodations/accomodation_condensed', locals: { accomodation: accomodation, index: index } %></div>
    <% end %>
  </div>
</div>
