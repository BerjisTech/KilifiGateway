<%
  owner = accomodation.owner
  user = owner.user
%>
<div class="d-flex flex-column h-full m-1 bg-slate-100 rounded-md" id="<%= dom_id accomodation %>">
  <div class="<%= dom_id accomodation %> d-flex position-relative align-items-center justify-content-center w-full  h-[250px] bg-cover bg-center bg-no-repeat">
    <span class="position-absolute top-0 start-0 material-icons bg-slate-100/90 rounded-md p-2 m-1">bookmark</span>
    <span class="position-absolute top-0 end-0 material-icons bg-slate-100/90 rounded-md p-2 m-1">search</span>
    <div class="position-absolute text-white bottom-0 rounded-md p-2 d-flex align-items-center justify-content-center w-full">
      <span class="bottom-0 start-0 material-icons bg-slate-600/70 rounded-md p-2 m-1">bookmark</span>
      <div class="text-white fw-bold bottom-0 flex-fill bg-slate-600/70 rounded-md px-3 py-2 d-flex flex-column align-items-center justify-content-center">
        <span>Price</span>
        <span class="fs-2">$ 1000</span>
      </div>
      <span class="bottom-0 start-0 material-icons bg-slate-600/70 rounded-md p-3 m-1">bookmark</span>
    </div>
    <img src="https://picsum.photos/500/300?random=<%= rand(1..10) %>" class="h-auto max-h-[250px] w-auto max-w-full" onload="processImage('<%= dom_id accomodation %>')">
  </div>
  <a class="bg-slate-300 rounded-md d-flex align-items-center justify-content-center text-decoration-none m-2 p-2 gap-2" href="<%= root_url %>u/<%= user.id %>">
    <img src='https://picsum.photos/500/300?random=<%= rand(1..10) %>' class="w-[50px] h-[50px] rounded-md bg-blue-400" />
    <div class="d-flex flex-column align-items-start justify-content-center h-full flex-fill">
      <span class="text-decoration-none text-slate-800"><%= user.name %></span>
      <span class="text-decoration-none text-slate-400">View Agent Profile</span>
    </div>
    <span class="material-icons">chevron_right</span>
  </a>
  <div class="d-flex flex-wrap align-items-start justify-content-start p-2">
    <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
      <strong class="font-medium text-decoration-none material-icons">bathroom</strong>:
      <%= accomodation.bathrooms %>
    </p>
    <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
      <strong class="font-medium text-decoration-none material-icons">bed</strong>:
      <%= accomodation.bedrooms %>
    </p>
    <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
      <strong class="font-medium text-decoration-none material-icons">balcony</strong>:
      <%= accomodation.balcony %>
    </p>
    <p class="d-flex flex-fill align-items-start justify-content-start gap-2">
      <strong class="font-medium text-decoration-none material-icons">room</strong>:
      <%= accomodation.location %>
    </p>
  </div>
  <p class="px-2">
    <strong class="block font-medium text-decoration-none mb-1"><%= accomodation.name %></strong>
  </p>
  <p class="flex-grow-1 p-2">
    <%= accomodation.description %>
  </p>
  <% if action_name != "show" %>
    <div class="w-full d-flex align-items-center justify-content-center gap-2 p-2">
      <%= link_to "View Details", accomodation, class: "bg-slate-300 flex-fill rounded-lg text-center p-2 inline-block font-medium text-decoration-none" %>
      <%- if current_user&.id == owner.user_id || current_user&.admin %>
        <%= link_to 'edit', edit_accomodation_path(accomodation), class: "bg-slate-300 material-icons text-center rounded-lg p-2 inline-block font-medium text-decoration-none" %>
      <% end %>
    </div>
  <% end %>
</div>
