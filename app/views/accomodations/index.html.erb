<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-blue-50 mb-5 text-blue-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>
  <div id="accomodations" class="min-w-full d-flex flex-wrap">
    <% @accomodations.each_with_index do |accomodation, index| %>
      <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3 mb-3"><%= render partial: 'accomodations/accomodation_condensed', locals: { accomodation: accomodation, index: index } %></div>
    <% end %>
  </div>
</div>
