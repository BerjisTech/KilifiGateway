<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>
  <div id="accomodations" class="min-w-full d-flex flex-wrap">
    <% @accomodations.each_with_index do |accomodation, index| %>
      <div class="col-sm-3 px-0 py-2 m-0"><%= render partial: 'accomodations/accomodation_condensed', locals: { accomodation: accomodation, index: index } %></div>
    <% end %>
  </div>
</div>
