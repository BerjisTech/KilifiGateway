<script>
  document.addEventListener("DOMContentLoaded", function() {
  });
  function processImage(element_class, image){
    var colorThief = new ColorThief();

    // Create a new Image object
    var img = new Image();
    img.crossOrigin = "Anonymous";  // This signals that we want to request CORS approval
    img.src = image;

    img.onload = function() {
        // Get the palette (we'll just use the first two colors here).
        var palette = colorThief.getPalette(img, 2);

        // Now you can set the gradient on your element.
        var element = document.querySelector(`.${element_class}`);
        element.style.background = `linear-gradient(to right, rgba(${palette[0].join(',')}), rgba(${palette[1].join(',')})), url('${img.src}') no-repeat`
        element.style.boxShadow = `0 0 100px rgba(${palette[0].join(',')}), 0 0 40px rgba(${palette[1].join(',')})`
        element.style.backgroundSize = 'cover'

        let color1 = `rgba(${palette[0].join(',')}, 0.5)`;
        let color2 = `rgba(${palette[1].join(',')}, 0.5)`;

        // Add the pseudo-element with the backdrop filter and background color.
        let style = document.createElement('style');
        style.innerHTML = `
        .${element_class}::before {
          content: "";
          position: absolute;
          top: 0;
          right: 0;
          bottom: 0;
          left: 0;
          backdrop-filter: blur(10px);
          background: linear-gradient(to right, ${color1}, ${color2});
          mix-blend-mode: overlay;
          z-index: -1;
        }
        `;
        document.head.appendChild(style);
    };
  }
</script>
<% if !is_devise_component && !is_control_room_component %>
  <% if flash.any? %>
    <% flash.each do |key, value| %>
      <% type = key.to_s.gsub('alert', 'danger').gsub('notice', 'success') %>
      <p id="flash-message" class="alert alert-<%= type %> custom_alert"><%= value %></p>
      <script>
        setTimeout(function() {
          const element = document.getElementById('flash-message');
          if (element) {
            element.style.display = 'none';
          }
        }, 5000); // 3 seconds
      </script>
    <% end %>
  <% end %>
<% end %>
