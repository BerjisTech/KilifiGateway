<%# Floating search icon that when clicked brings into view a search bar with service dropdown, category dropdown and a text input for search %>
<div class="w-full">
  <%= form_with url: search_path, method: :get, local: true, class: "d-flex algin-items-center justify-content-center gap-3" do |f| %>
    <div class="form-floating">
      <%= f.text_field :term, class: "form-control", placeholder: "Placeholder" %>
      <%= f.label :term, 'Search Term' %>
    </div>
    <div class="form-floating">
      <%= f.select :category, @search_categories, {}, class: "form-select", id: "floatingSelect", 'aria-label': "Services category" %>
      <%= f.label :category, 'Service Category', for: "floatingSelect" %>
    </div>
    <%= f.submit 'Search', class: "btn btn-primary btn-lg" %>
  <% end %>
</div>
