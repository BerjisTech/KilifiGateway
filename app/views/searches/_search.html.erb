<tr id="<%= dom_id search %>">
  <td><%= search.term %></td>
  <td><%= search.category %></td>
  <td><%= User.find(search.user_id).name %></td>
  <td><%= search.ip %></td>
  <td><%= link_to search.location %></td>
  <td><%= link_to search.referer %></td>
  <td><%= search.created_at %></td>
  <td>
    <% if action_name != "show" %>
      <div class="d-flex align-items-center justify-content-center">
        <%= link_to "Show this search", search, class: "text-decoration-none" %>
      </div>
    <% end %>
  </td>
</tr>
