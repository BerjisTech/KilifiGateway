<% 
  service_provider = on_demand_service.service_provider
%>
<div id="<%= dom_id on_demand_service %>" class="m-1 bg-white rounded-md p-2">
  <div class="position-relative w-full h-[250px] bg-blue-200 rounded-md">
    <div class="position-absolute d-flex align-items-center justify-content-between top-0 left-0 right-0 w-full p-2">
      <span class="material-icons">store</span>
      <span class="material-icons">wishlist</span>
    </div>
    <div class="position-absolute d-flex align-items-center justify-content-between bottom-0 left-0 right-0 w-full p-2">
      <span class="material-icons">store</span>
      <span class="material-icons">store</span>
    </div>
  </div>
  <% if action_name != "show" %>
    <div class="d-flex mt-2">
      <%= link_to "Request Service", on_demand_service, class: "flex-fill rounded-lg py-2 px-5 bg-gray-100 hover:bg-gray-200 inline-block font-medium d-flex align-items-center justify-content-center text-decoration-none" %>
      <% if current_user&.id == service_provider.user_id || current_user&.admin %>
        <%= link_to 'edit', edit_on_demand_service_path(on_demand_service), class: "material-icons rounded-lg py-2 ml-2 px-2 bg-gray-100 hover:bg-gray-200 inline-block font-medium" %>
      <% end %>
    </div>
  <% end %>
</div>
