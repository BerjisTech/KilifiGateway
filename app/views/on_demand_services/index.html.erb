<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>
  <div id="on_demand_services" class="d-flex flex-wrap min-w-full p-3">
    <% @on_demand_services.each_with_index do |on_demand_service, index| %>
      <div class="col-sm-3 p-0 m-0"><%= render partial: 'on_demand_services/on_demand_service_condensed', locals: { on_demand_service: on_demand_service, index: index } %></div>
    <% end %>
  </div>
</div>
