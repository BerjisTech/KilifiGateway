<div id="<%= dom_id on_demand_service %>">
  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">Service provider:</strong>
    <%= on_demand_service.service_provider_id %>
  </p>

  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">Name:</strong>
    <%= on_demand_service.name %>
  </p>

  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">Description:</strong>
    <%= on_demand_service.description %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this on demand service", on_demand_service, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium text-decoration-none" %>
    <%= link_to 'Edit this on demand service', edit_on_demand_service_path(on_demand_service), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium text-decoration-none" %>
    <hr class="mt-6">
  <% end %>
</div>
