<div class="mx-auto md:w-2/3 w-full flex">
  <div class="mx-auto">
    <% if notice.present? %>
      <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium text-decoration-none rounded-lg inline-block" id="notice"><%= notice %></p>
    <% end %>

    <%= render @on_demand_service %>

    <%= link_to 'Edit this on_demand_service', edit_on_demand_service_path(@on_demand_service), class: "mt-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium text-decoration-none" %>
    <div class="inline-block ml-2">
      <%= button_to 'Destroy this on_demand_service', on_demand_service_path(@on_demand_service), method: :delete, class: "mt-2 rounded-lg py-3 px-5 bg-gray-100 font-medium text-decoration-none" %>
    </div>
    <%= link_to 'Back to on_demand_services', on_demand_services_path, class: "ml-2 rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium text-decoration-none" %>
  </div>
</div>
