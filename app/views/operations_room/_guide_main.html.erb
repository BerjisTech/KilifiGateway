<div class="w-full d-flex align-items-start justify-content-center p-3">
  <div class="bg-white rounded-md p-3 w-[80%] min-w-[300px] d-flex flex-column gap-3">
    <% if current_user.suggest_owner_guide %>
      <%= render 'guide_owner' %>
    <% end %>
    <% if current_user.suggest_property_guide %>
      <%= render 'guide_property' %>
    <% end %>
    <% if current_user.suggest_service_provider_guide %>
      <%= render 'guide_service_provider' %>
    <% end %>
    <%= link_to "Skip", ignore_suggester_path(suggester: 'both'), class: "" %>
  </div>
</div>
<script>
  document.querySelectorAll('.ignore_suggester').forEach((e) => {
    e.addEventListener('change', (e) => {
      console.log(e.target.checked)
      window.location.href = `/ignore_suggester/${e.target.name}`
    })
  })
</script>
