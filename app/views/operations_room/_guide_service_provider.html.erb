<div class="d-flex flex-column gap-2">
  <div class="fs-4 fw-bold border-b-1 border-dashed border-slate-400 border-t-1 w-full p-2 d-flex justify-content-between align-items-center">
    <span>Want to provide on demand services</span>
    <%= link_to "Not Interested", ignore_suggester_path(suggester: 'service_provider'), class: "text-muted fs-6" %>
  </div>
  <div class="p-2">
    <div class="d-flex align-items-start justify-content-start gap-3" title="Mark as done">
      <input type="checkbox" name="service_provider" role="button" class="my-1 rounded-md ignore_suggester" id="service_provider"/>
      <div for="create_on_demand_service" class="d-flex flex-column align-items-start justify-content-start gap-2">
        <div class="fw-bold">Add your first service</div>
        <div>You can create multiple services and add schedules to each. Allow different customer on different tier to get your services at the comfort of their homes. Easily manage your finances in one area.</div>
        <%= link_to "Add your first service", new_on_demand_service_path, class: "bg-blue-800 hover:bg-blue-400 rounded-md text-white fw-bold p-2" %>
      </div>
    </div>
  </div>
</div>
