<div class="p-2 w-full">
  <div class="my-2 d-flex align-items-center justify-content-start">
    <div class="flex-fill"></div>
    <div class="form-floating w-[300px]">
      <input type="search" placeholder="Search" name="or_search_products" class="form-control">
      <label for="search">Search your products</label>
    </div>
  </div>
  <div>
    <table class="table table-condensed table-hover table-striped table-fixed table-responsive">
      <thead>
        <tr>
          <th>Product</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% @products.map do |product| %>
          <tr>
            <td><%= product.name %></td>
            <td>
              <%= link_to "visibility", product_path(product), class: "material-icons" %>
              <%= link_to "edit", edit_product_path(product), class: "material-icons text-red-500 hover:text-red-800" %>
              <%= link_to "delete", product_path(product), method: :delete, class: "material-icons text-red-500 hover:text-red-800" %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot></tfoot>
    </table>
  </div>
  <div class="my-2 d-flex align-items-center justify-content-start">
    <%= paginate @products %>
  </div>
</div>
