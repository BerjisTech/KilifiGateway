<% variant_choices = product_variant.variant_select_choices[0] %>
<div class="position-relative d-flex align-items-start justify-content-start flex-wrap gap-2 flex-column" id="<%= dom_id product_variant %>">
  <div class="d-flex align-items-center justify-content-between w-full bg-white gap-2 p-2">
    <div class="flex-fill d-flex align-items-center justify-content-start gap-2">
      <span class="fw-bold"><%= product_variant.name.capitalize %></span>
    </div>
    <div class="flex-fill d-flex align-items-center justify-content-between w-full bg-white gap-2 p-2" role="button">
      <div class="flex-fill">
        <% case product_variant.variant_type %>
        <% when 'select' %>
        <%= select_tag 'product_variant', options_for_select(variant_choices.map { |choice| [choice["name"], choice["name"]] }) %>
        <% when 'checkbox_group' %>
        <% variant_choices.each do |choice| %>
          <%= check_box_tag 'product_variant[]', choice['name'], false, id: choice["name"] %>
          <%= label_tag choice["name"] %>
        <% end %>
        <% when 'textarea' %>
        <%= text_area_tag 'product_variant' %>
        <% when 'checkbox' %>
        <%= check_box_tag 'product_variant' %>
        <% when 'radio' %>
        <% variant_choices.each do |choice| %>
          <%= radio_button_tag 'product_variant', choice['name'], false, id: choice['name'] %>
          <%= label_tag choice['name'] %>
        <% end %>
        <% when 'number' %>
        <%= number_field_tag 'product_variant' %>
        <% when 'text' %>
        <%= text_field_tag 'product_variant' %>
        <% when 'file' %>
        <%= file_field_tag 'product_variant' %>
        <% when 'date' %>
        <%= date_field_tag 'product_variant' %>
        <% when 'swatch' %>
        <%= color_field_tag 'product_variant' %>
      <% else %>
        <!-- Undefined variant type -->
      <% end %>
    </div>
    <div class="">$<%= product_variant.price %></div>
    <div class="d-flex align-items-center justify-content-center gap-1">
      <% if product_variant.best_seller %>
        <span class="bg-blue-500 text-white px-2 py-1 rounded-full text-xs">Best seller</span>
      <% end %>
      <% if product_variant.on_sale %>
        <span class="bg-red-500 text-white px-2 py-1 rounded-full text-xs">On Sale</span>
      <% end %>
      <% if product_variant.on_demand %>
        <span class="bg-red-500 text-white px-2 py-1 rounded-full text-xs">On Demand</span>
      <% end %>
    </div>
  </div>
</div>
</div>
