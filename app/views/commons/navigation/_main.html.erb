<% if !['sessions','registrations'].include? controller_name %>
  <div class="sticky top-0 fs-4 px-4 d-flex align-items-center justify-content-center w-full flex-wrap py-2 bg-slate-300">
    <span>Kilifi Gateway</span>
    <div class="fw-light text-green-800 flex-fill d-flex align-items-center justify-content-start mx-3 p-2 bg-slate-100 rounded-md gap-3">
      <%= link_to "Home", root_path, class: "text-decoration-none"%>
      <%= link_to "Accomodation", accomodations_path, class: "text-decoration-none"%>
      <%= link_to "Shopping", stores_path, class: "text-decoration-none #{ controller_name }"%>
      <%= link_to "On Demand Services", on_demand_services_path, class: "text-decoration-none"%>
      <%= link_to "Government Services", government_facilities_path, class: "text-decoration-none"%>
    </div>
    <div>
      <% if user_signed_in? %>
        <div>
          <%= link_to "Account", root_path, class: "text-decoration-none bg-slate-100 text-green-800 fw-bold py-2 px-3"%>
          <%= link_to "logout", destroy_user_session_path, class: "material-icons text-decoration-none bg-slate-100 text-green-800 fw-bold py-2 px-3"%>
        </div>
      <% else %>
        <%= link_to "Login", new_user_session_path, class: "text-decoration-none bg-slate-100 text-green-800 fw-bold py-2 px-3"%>
      <% end %>
    </div>
  </div>
<% end %>
