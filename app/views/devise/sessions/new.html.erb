<div class="row h-screen w-full">
  <div class="col-sm-6"></div>
  <div class="col-sm-6 h-full">
    <div class="rounded-md bg-white p-3 m-2 h-auto min-h-[500px]">
      <h2>Log in</h2>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="form-floating my-2">
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "----", class: "form-control" %>
          <%= f.label :email %>
        </div>
        <div class="form-floating my-2">
          <%= f.password_field :password, autocomplete: "current-password", placeholder: "----", class: "form-control" %>
          <%= f.label :password %>
        </div>
        <% if devise_mapping.rememberable? %>
          <div class="field">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me %>
          </div>
        <% end %>
        <div class="actions">
          <%= f.submit "Log in", class: "bg-green-800 hover:bg-green-600 p-2 text-white rounded-md w-[200px]" %>
        </div>
      <% end %>
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
