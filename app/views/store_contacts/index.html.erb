<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-blue-50 mb-5 text-blue-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Store contacts</h1>
    <%= link_to 'New store contact', new_store_contact_path, class: "rounded-lg py-3 px-5 bg-blue-600 text-white block font-medium" %>
  </div>

  <div id="store_contacts" class="min-w-full">
    <%= render @store_contacts %>
  </div>
</div>
