<div id="<%= dom_id wallet %>">
  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">User:</strong>
    <%= wallet.user_id %>
  </p>

  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">Currency:</strong>
    <%= wallet.currency %>
  </p>

  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">Amount:</strong>
    <%= wallet.amount %>
  </p>

  <p class="my-5">
    <strong class="block font-medium text-decoration-none mb-1">Conversion rate:</strong>
    <%= wallet.conversion_rate %>
  </p>

  <% if action_name != "show" %>
    <%= link_to "Show this wallet", wallet, class: "rounded-lg py-3 px-5 bg-gray-100 inline-block font-medium text-decoration-none" %>
    <%= link_to 'Edit this wallet', edit_wallet_path(wallet), class: "rounded-lg py-3 ml-2 px-5 bg-gray-100 inline-block font-medium text-decoration-none" %>
    <hr class="mt-6">
  <% end %>
</div>
